{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe",
  "type": "object",
  "required": ["slug", "title", "one_liner", "problem", "audience", "steps", "final_result", "total_time_minutes", "replaces", "status", "environment", "verified_at", "confidence_notes"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "one_liner": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "audience": { "enum": ["începător", "intermediar", "avansat"] },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["repo_slug", "what_it_does", "input", "output", "commands", "real_output"],
        "properties": {
          "repo_slug": { "type": "string" },
          "what_it_does": { "type": "string" },
          "input": { "type": "string" },
          "output": { "type": "string" },
          "commands": { "type": "array", "items": { "type": "string" } },
          "code": { "type": ["string", "null"] },
          "real_output": { "type": ["string", "null"] }
        }
      }
    },
    "final_result": { "type": ["string", "null"] },
    "total_time_minutes": { "type": ["number", "null"], "minimum": 0 },
    "replaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "service_url", "price", "price_source_url", "price_checked_at", "what_you_lose"],
        "properties": {
          "service": { "type": "string" },
          "service_url": { "type": "string" },
          "price": { "type": ["string", "null"] },
          "price_source_url": { "type": ["string", "null"] },
          "price_checked_at": { "type": ["string", "null"] },
          "what_you_lose": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "needs_recheck": { "type": "boolean" }
        }
      }
    },
    "status": { "enum": ["verificat", "esuat", "neverificat"] },
    "failure_reason": { "type": ["string", "null"] },
    "environment": { "type": "object" },
    "verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "confidence_notes": { "type": "string" }
  }
}
