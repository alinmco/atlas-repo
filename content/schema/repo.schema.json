{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repo",
  "type": "object",
  "required": [
    "slug",
    "repo_url",
    "name",
    "one_liner",
    "problem_solved",
    "analogy",
    "how_it_works",
    "categories",
    "search_intents",
    "audience",
    "setup_difficulty",
    "replaces",
    "examples",
    "connectors",
    "when_not_to_use",
    "alternatives",
    "tech_sheet",
    "updated_at"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "repo_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "one_liner": {
      "type": "string",
      "minLength": 1
    },
    "problem_solved": {
      "type": "string",
      "minLength": 1
    },
    "analogy": {
      "type": "string",
      "minLength": 1
    },
    "how_it_works": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_intents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "enum": [
        "începător",
        "intermediar",
        "avansat"
      ]
    },
    "setup_difficulty": {
      "enum": [
        "ușor",
        "mediu",
        "greu"
      ]
    },
    "replaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "service",
          "service_url",
          "price",
          "price_source_url",
          "price_checked_at",
          "replacement_level",
          "what_you_keep",
          "what_you_lose",
          "hidden_costs"
        ],
        "properties": {
          "service": {
            "type": "string",
            "minLength": 1
          },
          "service_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "price": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_checked_at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "replacement_level": {
            "enum": [
              "aproape complet",
              "parțial",
              "doar pentru cazuri simple"
            ]
          },
          "what_you_keep": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "what_you_lose": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "hidden_costs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "scenario",
          "prerequisites",
          "commands",
          "source_url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_from_docs": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "kind": {
            "enum": [
              "instalare",
              "folosire"
            ]
          }
        }
      }
    },
    "connectors": {
      "type": "object",
      "required": [
        "inputs",
        "outputs",
        "pairs_well_with",
        "gaps_noticed"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pairs_well_with": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repo_url",
              "name",
              "why"
            ],
            "properties": {
              "repo_url": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "in_catalog": {
                "type": "boolean"
              }
            }
          }
        },
        "gaps_noticed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "when_not_to_use": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "difference"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "difference": {
            "type": "string"
          }
        }
      }
    },
    "tech_sheet": {
      "type": "object",
      "required": [
        "license",
        "language",
        "last_commit_date",
        "stars",
        "requirements"
      ],
      "properties": {
        "license": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_commit_date": {
          "type": "string"
        },
        "stars": {
          "type": [
            "number",
            "null"
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "monetization": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "model",
          "what_you_sell",
          "for_whom",
          "license_check",
          "demand_evidence",
          "startup_cost",
          "time_to_first_client",
          "difficulty",
          "risks",
          "first_steps",
          "path"
        ],
        "properties": {
          "model": {
            "enum": [
              "serviciu de instalare și configurare",
              "găzduire gestionată",
              "produs construit peste repo",
              "consultanță și training",
              "conținut și cursuri",
              "integrare pentru o nișă",
              "altul"
            ]
          },
          "what_you_sell": {
            "type": "string",
            "minLength": 1
          },
          "for_whom": {
            "type": "string",
            "minLength": 1
          },
          "license_check": {
            "type": "object",
            "required": [
              "license",
              "commercial_use",
              "conditions"
            ],
            "properties": {
              "license": {
                "type": "string",
                "minLength": 1
              },
              "commercial_use": {
                "enum": [
                  "permis",
                  "permis cu condiții",
                  "interzis",
                  "neclar"
                ]
              },
              "conditions": {
                "type": "string"
              }
            }
          },
          "demand_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "url",
                "what_it_proves",
                "checked_at"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "price": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "what_it_proves": {
                  "type": "string",
                  "minLength": 1
                },
                "checked_at": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          },
          "startup_cost": {
            "type": "string",
            "minLength": 1
          },
          "time_to_first_client": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "enum": [
              "ușor",
              "mediu",
              "greu"
            ]
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "first_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "path": {
            "enum": [
              "folosești repo-ul direct",
              "construiești propria implementare"
            ]
          },
          "own_build_notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "at_a_glance": {
      "type": "object",
      "required": [
        "for_you_if",
        "not_for_you_if",
        "verdict"
      ],
      "properties": {
        "for_you_if": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "not_for_you_if": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "verdict": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "level",
        "summary"
      ],
      "properties": {
        "level": {
          "enum": [
            "gratuit complet",
            "gratuit, dar cere servicii plătite",
            "plătit",
            "necunoscut"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "what",
              "price",
              "required",
              "source_url"
            ],
            "properties": {
              "what": {
                "type": "string",
                "minLength": 1
              },
              "price": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "source_url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "platforms": {
      "type": "object",
      "required": [
        "windows",
        "mac",
        "linux"
      ],
      "properties": {
        "windows": {
          "enum": [
            "da",
            "parțial",
            "nu",
            "necunoscut"
          ]
        },
        "mac": {
          "enum": [
            "da",
            "parțial",
            "nu",
            "necunoscut"
          ]
        },
        "linux": {
          "enum": [
            "da",
            "parțial",
            "nu",
            "necunoscut"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag",
          "detail"
        ],
        "properties": {
          "flag": {
            "enum": [
              "trimite date în cloud",
              "telemetrie",
              "cere cont",
              "modifică setările altor programe",
              "proiect instabil",
              "licență restrictivă",
              "cere plată"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "audience_reason": {
      "type": "string"
    },
    "setup_difficulty_reason": {
      "type": "string"
    },
    "notes_summary": {
      "type": "string"
    }
  }
}
