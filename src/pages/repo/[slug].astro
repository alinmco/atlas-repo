---
import Base from "../../layouts/Base.astro";
import Monetization from "../../components/Monetization.astro";
import InstallPrompt from "../../components/InstallPrompt.astro";
import { repos, repoByUrl, recipesUsing, formatDate } from "../../lib/data.js";

export function getStaticPaths() {
  return repos.map((repo) => ({ params: { slug: repo.slug }, props: { repo } }));
}

const { repo } = Astro.props;
const inRecipes = recipesUsing(repo.slug);
const sha = repo.tech_sheet.commit_sha;
const restricted = repo.monetization?.some((m) => ["interzis", "neclar"].includes(m.license_check?.commercial_use));
---

<Base title={repo.name} description={repo.one_liner}>
  <article class="wrap">
    <header class="head">
      <nav class="crumb soft" aria-label="Navigare">
        <ol class="plain">
          <li><a href="/">Acasă</a></li>
          <li><a href="/">Repo-uri</a></li>
          <li aria-current="page">{repo.name}</li>
        </ol>
      </nav>
      <h1>{repo.name}</h1>
      <p class="lede">{repo.one_liner}</p>
      <p class="head-meta">
        <span class="stamp stamp--doc">Din documentația oficială, {formatDate(repo.updated_at)}</span>
        <a href={repo.repo_url} target="_blank" rel="noopener noreferrer">Vezi codul pe GitHub</a>
      </p>
    </header>

    <InstallPrompt repo={repo} />

    <div class="layout">
      <div class="main">
        <section>
          <h2>Ce problemă rezolvă</h2>
          <p class="prose">{repo.problem_solved}</p>
          <p class="analogy prose">{repo.analogy}</p>
        </section>

        <section>
          <h2>Cum funcționează</h2>
          <ol class="flow">
            {repo.how_it_works.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        {repo.replaces.length > 0 && (
          <section>
            <h2>Alternativă gratuită la</h2>
            <div class="replaces">
              {repo.replaces.map((s) => (
                <div class="service">
                  <h3>
                    <a href={s.service_url} target="_blank" rel="noopener noreferrer">{s.service}</a>
                  </h3>
                  <p class="price">
                    {s.price ? (
                      <>
                        {s.price}
                        {s.price_source_url && (
                          <span class="soft">
                            {" "}(<a href={s.price_source_url} target="_blank" rel="noopener noreferrer">consultat {formatDate(s.price_checked_at)}</a>)
                          </span>
                        )}
                      </>
                    ) : (
                      <span class="soft">Preț nepublicat</span>
                    )}
                  </p>
                  <p class="level">Înlocuire {s.replacement_level}</p>
                  <dl class="tradeoffs">
                    {s.what_you_keep.length > 0 && (
                      <>
                        <dt>Ce primești la fel</dt>
                        <dd>{s.what_you_keep.join(", ")}</dd>
                      </>
                    )}
                    <dt>Ce pierzi</dt>
                    <dd>{s.what_you_lose.join(", ")}</dd>
                    {s.hidden_costs.length > 0 && (
                      <>
                        <dt>Costuri ascunse</dt>
                        <dd>{s.hidden_costs.join(", ")}</dd>
                      </>
                    )}
                  </dl>
                </div>
              ))}
            </div>
          </section>
        )}

        <section>
          <h2>{repo.examples.length === 1 ? "Exemplu din documentație" : "Exemple din documentație"}</h2>
          <p class="prose soft doc-note">
            {repo.examples.length === 1
              ? "Exemplul e preluat din documentația oficială a proiectului. Nu l-am rulat noi, așa că verifică sursa pentru versiunea cea mai nouă."
              : "Exemplele sunt preluate din documentația oficială a proiectului. Nu le-am rulat noi, așa că verifică sursa pentru versiunea cea mai nouă."}
          </p>
          {repo.examples.map((ex) => (
            <div class="example">
              <h3>{ex.title}</h3>
              <p class="prose">{ex.scenario}</p>
              {ex.prerequisites.length > 0 && (
                <p class="soft prereq">Ai nevoie de: {ex.prerequisites.join(", ")}</p>
              )}
              {ex.commands.length > 0 && (
                <pre class="terminal terminal--commands"><code>{ex.commands.join("\n")}</code></pre>
              )}
              {ex.code && <pre class="terminal"><code>{ex.code}</code></pre>}
              {ex.output_from_docs && (
                <figure class="doc-output">
                  <figcaption class="soft">Rezultatul arătat în documentație</figcaption>
                  <pre class="terminal"><code>{ex.output_from_docs}</code></pre>
                </figure>
              )}
              <p class="soft source">
                Sursa: <a href={ex.source_url} target="_blank" rel="noopener noreferrer">documentația oficială</a>
              </p>
            </div>
          ))}
        </section>

        <section>
          <h2>Când să nu-l folosești</h2>
          <ul class="prose">
            {repo.when_not_to_use.map((w) => <li>{w}</li>)}
          </ul>
          {repo.alternatives.length > 0 && (
            <>
              <h3 class="sub">Alternative</h3>
              <ul class="prose">
                {repo.alternatives.map((a) => (
                  <li>
                    <a href={a.url} target="_blank" rel="noopener noreferrer">{a.name}</a>: {a.difference}
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        {(repo.connectors.pairs_well_with.length > 0 || inRecipes.length > 0) && (
          <section>
            <h2>Se combină bine cu</h2>
            <ul class="prose">
              {repo.connectors.pairs_well_with.map((p) => {
                const local = repoByUrl(p.repo_url);
                return (
                  <li>
                    {local ? <a href={`/repo/${local.slug}/`}>{p.name}</a> : <a href={p.repo_url} target="_blank" rel="noopener noreferrer">{p.name}</a>}
                    {!local && <span class="soft"> (încă nu e în atlas)</span>}: {p.why}
                  </li>
                );
              })}
            </ul>
            {inRecipes.length > 0 && (
              <p class="prose recipes-line">
                Apare în rețetele:{" "}
                {inRecipes.map((r, i) => (
                  <>
                    {i > 0 && ", "}
                    <a href={`/retete/${r.slug}/`}>{r.title}</a>
                  </>
                ))}
                .
              </p>
            )}
          </section>
        )}

        {repo.monetization?.length > 0 && (
          <section>
            <h2>Cum poți câștiga bani cu el</h2>
            <p class="prose soft money-note">
              Idei pornite de la licență și de la afaceri care vând deja ceva asemănător. Nu sunt promisiuni de venit
              și nici sfat juridic sau financiar.
              {restricted && " Licența acestui repo nu permite uzul comercial, deci ideile se pot face doar cu o implementare proprie."}
            </p>
            {repo.monetization.map((idea) => <Monetization idea={idea} />)}
          </section>
        )}

        {repo.notes && (
          <section>
            <h2>Note</h2>
            <p class="prose soft">{repo.notes}</p>
          </section>
        )}
      </div>

      <aside class="sheet" aria-label="Fișa tehnică">
        <h2>Fișa tehnică</h2>
        <dl>
          <dt>Pentru</dt>
          <dd>{repo.audience}</dd>
          <dt>Pornire</dt>
          <dd>{repo.setup_difficulty}</dd>
          <dt>Licență</dt>
          <dd>{repo.tech_sheet.license}</dd>
          <dt>Limbaj</dt>
          <dd>{repo.tech_sheet.language}</dd>
          {sha && (
            <>
              <dt>Versiune citită</dt>
              <dd><code>{sha.slice(0, 7)}</code></dd>
            </>
          )}
          <dt>Ultimul commit</dt>
          <dd>{formatDate(repo.tech_sheet.last_commit_date)}</dd>
          {typeof repo.tech_sheet.stars === "number" && (
            <>
              <dt>Stele</dt>
              <dd>{repo.tech_sheet.stars.toLocaleString("ro-RO")}</dd>
            </>
          )}
          {repo.tech_sheet.requirements.length > 0 && (
            <>
              <dt>Cerințe</dt>
              <dd>{repo.tech_sheet.requirements.join(", ")}</dd>
            </>
          )}
          <dt>Categorii</dt>
          <dd>{repo.categories.join(", ")}</dd>
        </dl>
      </aside>
    </div>
  </article>
</Base>

<style>
  .head {
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .crumb {
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }

  .crumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .crumb li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .crumb li + li::before {
    content: "›";
    margin: 0 0.1rem 0 0;
  }

  .crumb a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .crumb a:hover {
    text-decoration: underline;
  }

  .crumb [aria-current] {
    color: var(--ink);
  }

  h1 {
    font-size: var(--step-3);
  }

  .lede {
    font-size: var(--step-1);
    margin-top: 0.5rem;
    max-width: 40ch;
  }

  .head-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: 4rem;
    }

    .sheet {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }

  section {
    margin-bottom: 3rem;
  }

  section h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }

  h3 {
    font-size: var(--step-1);
  }

  .sub {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .analogy {
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 3px solid var(--rule);
    font-style: italic;
  }

  .flow {
    padding-left: 1.4rem;
    max-width: var(--measure);
  }

  .flow li + li {
    margin-top: 0.4rem;
  }

  .replaces {
    display: grid;
    gap: 1.5rem;
  }

  .service {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .price {
    margin-top: 0.25rem;
  }

  .level {
    font-size: var(--step--1);
    margin-top: 0.25rem;
  }

  .tradeoffs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.15rem;
    margin: 0.75rem 0 0;
    max-width: var(--measure);
  }

  @media (min-width: 40rem) {
    .tradeoffs {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 0.4rem 1rem;
    }
  }

  .tradeoffs dt {
    font-weight: 700;
  }

  .tradeoffs dd {
    margin: 0 0 0.5rem;
  }

  .doc-note,
  .money-note {
    font-size: var(--step--1);
    margin-bottom: 1.25rem;
  }

  .example {
    margin-bottom: 2.5rem;
  }

  .example > * + * {
    margin-top: 0.75rem;
  }

  .prereq,
  .source {
    font-size: var(--step--1);
  }

  .doc-output {
    margin: 0.75rem 0 0;
  }

  .doc-output figcaption {
    font-size: var(--step--1);
    margin-bottom: 0.4rem;
  }

  .recipes-line {
    margin-top: 1rem;
  }

  .sheet {
    padding: 1.25rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .sheet h2 {
    font-size: var(--step-1);
    margin-bottom: 0.75rem;
  }

  .sheet dl {
    margin: 0;
  }

  .sheet dt {
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }

  .sheet dd {
    margin: 0;
  }
</style>
