---
import Base from "../../layouts/Base.astro";
import { recipes, repoBySlug, formatDate } from "../../lib/data.js";

export function getStaticPaths() {
  return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe } }));
}

const { recipe } = Astro.props;
---

<Base title={recipe.title} description={recipe.one_liner}>
  <article class="wrap">
    <header class="head">
      <p class="crumb soft"><a href="/retete/">Toate rețetele</a></p>
      <h1>{recipe.title}</h1>
      <p class="lede">{recipe.one_liner}</p>
      <p class="head-meta">
        <span class="stamp stamp--doc">Rețetă propusă, netestată</span>
        <span class="soft">Propusă {formatDate(recipe.created_at)}</span>
        <span class="soft">Pentru {recipe.audience}</span>
      </p>
    </header>

    <section>
      <h2>Problema</h2>
      <p class="prose">{recipe.problem}</p>
    </section>

    <section>
      <h2>Pașii</h2>
      <p class="prose soft note">
        Fiecare pas folosește comenzi din documentația oficială a proiectului respectiv. Nu am rulat fluxul cap-coadă,
        așa că e posibil să fie nevoie de mici ajustări.
      </p>
      <ol class="plain steps">
        {recipe.steps.map((step, i) => {
          const repo = repoBySlug(step.repo_slug);
          return (
            <li class="step">
              <p class="step-num" aria-hidden="true">{i + 1}</p>
              <div class="step-body">
                <h3>{repo ? <a href={`/repo/${repo.slug}/`}>{repo.name}</a> : step.repo_slug}</h3>
                <p class="prose">{step.what_it_does}</p>
                <p class="soft io">Primește {step.input} și produce {step.output}.</p>
                {step.commands.length > 0 && (
                  <pre class="terminal terminal--commands"><code>{step.commands.join("\n")}</code></pre>
                )}
                {step.code && <pre class="terminal"><code>{step.code}</code></pre>}
                {step.source_url && (
                  <p class="soft io">
                    Sursa: <a href={step.source_url} target="_blank" rel="noopener noreferrer">documentația oficială</a>
                  </p>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>

    <section>
      <h2>Ce ar trebui să obții</h2>
      <p class="prose">{recipe.expected_result}</p>
    </section>

    {recipe.replaces.length > 0 && (
      <section>
        <h2>Ce ar putea înlocui întregul flux</h2>
        <ul class="prose">
          {recipe.replaces.map((s) => (
            <li>
              <a href={s.service_url} target="_blank" rel="noopener noreferrer">{s.service}</a>
              {s.price && <> ({s.price}{s.price_source_url && <>, <a href={s.price_source_url} target="_blank" rel="noopener noreferrer">consultat {formatDate(s.price_checked_at)}</a></>})</>}.
              Ce pierzi: {s.what_you_lose.join(", ")}.
            </li>
          ))}
        </ul>
      </section>
    )}

    {recipe.notes && (
      <section>
        <h2>Note</h2>
        <p class="prose soft">{recipe.notes}</p>
      </section>
    )}
  </article>
</Base>

<style>
  .head {
    padding: 2.5rem 0 2rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 2rem;
  }

  .crumb {
    font-size: var(--step--1);
    margin-bottom: 1rem;
  }

  h1 {
    font-size: var(--step-3);
  }

  .lede {
    font-size: var(--step-1);
    margin-top: 0.5rem;
    max-width: 40ch;
  }

  .head-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.25rem;
    font-size: var(--step--1);
  }

  section {
    margin-bottom: 3rem;
    max-width: 52rem;
  }

  section h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
  }

  .note {
    font-size: var(--step--1);
    margin-bottom: 1.5rem;
  }

  .step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 2rem;
  }

  .step-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--ink-soft);
  }

  .step-body > * + * {
    margin-top: 0.75rem;
  }

  .step-body h3 {
    font-size: var(--step-1);
  }

  .io {
    font-size: var(--step--1);
  }
</style>
